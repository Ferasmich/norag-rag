# Copy to .env. Never commit your key.
# You can also put personal overrides in .env.local (git-ignored too).
# Precedence: real environment variables, then .env.local, then .env.

# Any OpenAI-compatible model. Leave LLM_URL empty to use Google Gemini.
LLM_URL=
LLM_API_KEY=your_api_key_here
LLM_MODEL=gemini-3.5-flash-lite
# Examples:
#   OpenAI:  LLM_URL=https://api.openai.com/v1   LLM_MODEL=gpt-4o-mini
#   Ollama:  LLM_URL=http://localhost:11434/v1   LLM_MODEL=llama3.1   (LLM_API_KEY can stay empty)

# Seconds to wait for one model call. A slow local model may need 300 or more.
# LLM_TIMEOUT=45

# Older names, still accepted for Google Gemini only (when LLM_URL is empty or Google's).
# GOOGLE_API_KEY is never sent to another LLM_URL: set LLM_API_KEY for that provider.
# GOOGLE_API_KEY=your_google_api_key_here
# GOOGLE_MODEL=gemini-3.5-flash-lite

# Optional; defaults to ./data
# RAG_DATA_DIR=./data
# Concept graph of an uploaded file. By default nothing is sent to the model on upload:
# you click "Build graph" next to the document (one model call per passage).
# Set RAG_GRAPH_AUTO=1 to build it automatically on upload, up to this many passages.
# RAG_GRAPH_AUTO=0
# RAG_GRAPH_AUTO_MAX_CHUNKS=60
